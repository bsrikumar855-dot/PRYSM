{
  "format": "prysm-demo-replay",
  "version": 1,
  "label": "DEMO-ONLY. Hand-written from the OpenAI-compatible Chat Completions shape in the Meta Model API docs (https://dev.meta.ai/docs). These are NOT recordings of a real model. Synthetic data only.",
  "entries": [
    {
      "id": "safe-lookup",
      "note": "scenario 1: a read-only tool the policy allows",
      "match": {
        "last_user_includes": "ORD-1001"
      },
      "response": {
        "id": "fixture-lookup_order",
        "object": "chat.completion",
        "model": "replay-fixture",
        "choices": [
          {
            "index": 0,
            "message": {
              "role": "assistant",
              "content": null,
              "tool_calls": [
                {
                  "id": "call_1",
                  "type": "function",
                  "function": {
                    "name": "lookup_order",
                    "arguments": "{\"order_id\": \"ORD-1001\"}"
                  }
                }
              ]
            },
            "finish_reason": "tool_calls"
          }
        ]
      }
    },
    {
      "id": "blocked-export",
      "note": "scenario 2: a tool the policy denies",
      "match": {
        "last_user_includes": "export every customer record"
      },
      "response": {
        "id": "fixture-export_customer_data",
        "object": "chat.completion",
        "model": "replay-fixture",
        "choices": [
          {
            "index": 0,
            "message": {
              "role": "assistant",
              "content": null,
              "tool_calls": [
                {
                  "id": "call_1",
                  "type": "function",
                  "function": {
                    "name": "export_customer_data",
                    "arguments": "{\"scope\": \"all\"}"
                  }
                }
              ]
            },
            "finish_reason": "tool_calls"
          }
        ]
      }
    },
    {
      "id": "approval-refund",
      "note": "scenario 3: a refund above the limit, which needs a human",
      "match": {
        "last_user_includes": "ORD-2002"
      },
      "response": {
        "id": "fixture-refund_payment",
        "object": "chat.completion",
        "model": "replay-fixture",
        "choices": [
          {
            "index": 0,
            "message": {
              "role": "assistant",
              "content": null,
              "tool_calls": [
                {
                  "id": "call_1",
                  "type": "function",
                  "function": {
                    "name": "refund_payment",
                    "arguments": "{\"order_id\": \"ORD-2002\", \"amount_inr\": 9000}"
                  }
                }
              ]
            },
            "finish_reason": "tool_calls"
          }
        ]
      }
    },
    {
      "id": "prompted-external-email",
      "note": "Mode B: no native tool_calls, a JSON tool request in the text",
      "match": {
        "last_user_includes": "email the partner"
      },
      "response": {
        "id": "fixture-text",
        "object": "chat.completion",
        "model": "replay-fixture",
        "choices": [
          {
            "index": 0,
            "message": {
              "role": "assistant",
              "content": "```json\n{\"tool_calls\":[{\"name\":\"send_email\",\"arguments\":{\"audience\":\"external\",\"subject\":\"Quarterly summary\"}}]}\n```"
            },
            "finish_reason": "stop"
          }
        ]
      }
    },
    {
      "id": "malformed-arguments",
      "note": "native tool call whose arguments are not valid JSON",
      "match": {
        "last_user_includes": "broken arguments"
      },
      "response": {
        "id": "fixture-lookup_order",
        "object": "chat.completion",
        "model": "replay-fixture",
        "choices": [
          {
            "index": 0,
            "message": {
              "role": "assistant",
              "content": null,
              "tool_calls": [
                {
                  "id": "call_1",
                  "type": "function",
                  "function": {
                    "name": "lookup_order",
                    "arguments": "{not json"
                  }
                }
              ]
            },
            "finish_reason": "tool_calls"
          }
        ]
      }
    },
    {
      "id": "unknown-tool",
      "note": "a tool that was never offered",
      "match": {
        "last_user_includes": "wipe the database"
      },
      "response": {
        "id": "fixture-delete_database",
        "object": "chat.completion",
        "model": "replay-fixture",
        "choices": [
          {
            "index": 0,
            "message": {
              "role": "assistant",
              "content": null,
              "tool_calls": [
                {
                  "id": "call_1",
                  "type": "function",
                  "function": {
                    "name": "delete_database",
                    "arguments": "{\"name\": \"prod\"}"
                  }
                }
              ]
            },
            "finish_reason": "tool_calls"
          }
        ]
      }
    },
    {
      "id": "plain-answer",
      "note": "no tool request at all",
      "match": {
        "last_user_includes": "what can you do"
      },
      "response": {
        "id": "fixture-text",
        "object": "chat.completion",
        "model": "replay-fixture",
        "choices": [
          {
            "index": 0,
            "message": {
              "role": "assistant",
              "content": "I can look up orders and help with refunds."
            },
            "finish_reason": "stop"
          }
        ]
      }
    }
  ]
