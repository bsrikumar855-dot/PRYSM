    "check:schema": "drizzle-kit check"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "pg": "8.23.0",
    "@types/pg": "8.23.1"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11"
  }
}
