# Local development defaults for the docker compose stack (pnpm infra:up). Dev-only credentials.
# Copy to .env; never commit .env. Production values come from the deployment's secret store.
DATABASE_URL_OWNER=postgres://prysm_owner:prysm-owner-dev-only@127.0.0.1:5432/prysm
DATABASE_URL_APP=postgres://prysm_app:prysm-app-dev-only@127.0.0.1:5432/prysm
VALKEY_URL=redis://127.0.0.1:6379
S3_ENDPOINT=http://127.0.0.1:8333
S3_ACCESS_KEY_ID=prysm-dev
S3_SECRET_ACCESS_KEY=prysm-dev-only-secret
S3_EVIDENCE_BUCKET=prysm-evidence-dev
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
